function sporkiAppCheck() {
	IS_ANDROID = (/(.*SPORKI_APP\/PLATFORM_AOS\/VERSION.*)/gi.test(navigator.userAgent));
	IS_IOS = (/(.*PLATFORM_IOS_WEBVIEW.*)/gi.test(navigator.userAgent));
	if (IS_ANDROID) return 1;
	else if (IS_IOS) return 2;
	else return 0;
}

