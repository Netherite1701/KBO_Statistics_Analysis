function wcNative_deviceCheck() {
	var IS_ANDROID = (/\(.*Android.*\)/gi.test(navigator.userAgent));
	var IS_IOS = (/\(.*iPhone.*\)/gi.test(navigator.userAgent) || /\(.*iPad.*\)/gi.test(navigator.userAgent));

	if (IS_ANDROID) {
		return "ANDROID";
	} else if (IS_IOS) {
		return "IOS"
	} else {
		return "NOT_DEVICE";
	}
}


