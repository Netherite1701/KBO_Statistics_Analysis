function hrMsg(type, message, callback, callbackC) {
	if (!$('#div_alert').attr('id')) {
		if (typeof callback == 'function') callback();
		else if (callback) eval(callback);
		return;
	}
	if (type == 'C' || type == 'L') $('.aCancle').show();
	if(type == 'L'){
		$('.aConfirm').html('로그인');
	}
	else $('.aCancle').hide();

	$('.alertMsg').html(message);
	$('.all_bg').show();
	$('#div_alert').fadeIn();
	$('body').addClass('noscroll');


	$('.aConfirm').focus();
	$('.aConfirm').on('click enter', function () {
		$('.all_bg').hide();
		$('#div_alert').fadeOut();
		$('body').removeClass('noscroll');
		$('.aConfirm').html('확인');
		if (typeof callback != 'undefined' && callback) {
			if (typeof callback == 'function') callback();
			else if (callback) eval(callback);
			$(this).unbind('click');
		}
	});

	$('.aCancle').click(function () {
		$('.all_bg').hide();
		$('#div_alert').fadeOut();
		$('body').removeClass('noscroll');

		$('.aConfirm').html('확인');
		
		if (typeof callbackC != 'undefined' && callbackC) {
			if (typeof callbackC == 'function') callbackC();
			else if (callbackC) eval(callbackC);
			$(this).unbind('click');
		}
	});
}

